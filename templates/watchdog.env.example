# Copy to the repo root as `watchdog.env`. Non-secret settings for
# scripts/session-watchdog.py. The PASSWORD is NOT here — store it in the
# macOS Keychain:
#   security add-generic-password -s aventproxy-tuya -a you@example.com -w
EMAIL=you@example.com
# ISO-2 country of the Baby Monitor+ account (used to pick the Tuya calling code)
COUNTRY=US
